<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laventurosa.adapters.ui.panels.GenerarReportePanel">
    <children>
        <VBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <Label text="Generar Reporte de Calidad de Agua" textFill="#2447A4">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <children>
                        <Label text="Seleccione el rango de fechas:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <HBox spacing="20.0">
                            <children>
                                <DatePicker fx:id="dateInicio" promptText="Fecha Inicio" />
                                <DatePicker fx:id="dateFin" promptText="Fecha Fin" />
                            </children>
                        </HBox>
                        <Button style="-fx-background-color: #2447A4; -fx-text-fill: white;" text="Exportar a PDF" prefHeight="40.0" prefWidth="200.0" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>