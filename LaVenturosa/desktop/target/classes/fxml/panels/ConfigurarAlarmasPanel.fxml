<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #EDF4FB;" stylesheets="@../../styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laventurosa.adapters.ui.panels.ConfigurarAlarmasPanel">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label text="Sistema de Alarmas y Notificaciones" textFill="#2447A4">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="15.0" styleClass="panel-choince-vq" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnAbrirAgregar" mnemonicParsing="false" onAction="#agregarCorreo" styleClass="btn-guardar" text="+ Agregar Correo Notificación" />

                        <TableView fx:id="tablaCorreos" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCorreo" prefWidth="250.0" text="Email destinatario" />
                                <TableColumn fx:id="colFrecuencia" prefWidth="200.0" text="Nivel de notificación" />
                                <TableColumn fx:id="colActivo" prefWidth="150.0" text="Activo" />
                                <TableColumn fx:id="colAcciones" prefWidth="150.0" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>