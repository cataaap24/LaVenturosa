<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laventurosa.adapters.ui.panels.HistorialPanel">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <Label text="Historial de Mediciones - Venturosa" textFill="#2447A4">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <TableView fx:id="tablaHistorial" prefHeight="400.0" prefWidth="640.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Fecha" prefWidth="150.0" />
                        <TableColumn text="Sensor" prefWidth="100.0" />
                        <TableColumn text="pH" prefWidth="100.0" />
                        <TableColumn text="Oxígeno" prefWidth="100.0" />
                        <TableColumn text="Estado" prefWidth="150.0" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>