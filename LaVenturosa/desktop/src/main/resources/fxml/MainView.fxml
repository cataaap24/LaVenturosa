<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" stylesheets="@../styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laventurosa.adapters.ui.MainView">
    <left>
        <VBox fillWidth="true" prefHeight="600.0" prefWidth="216.0" spacing="10.0" style="-fx-background-color: #2447A4;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" prefHeight="40.0" prefWidth="170.0">
                    <children>
                        <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/Logo.png" />
                            </image>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin>
                        </ImageView>
                        <Label alignment="CENTER_RIGHT" contentDisplay="CENTER" text="VenturosaSystem" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" top="10.0" />
                    </VBox.margin>
                </HBox>

                <Button fx:id="btnEstado" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarEstado" prefHeight="44.0" styleClass="button-lateral" text="• Estado de la laguna">
               <font>
                  <Font size="14.0" />
               </font></Button>
                <Button fx:id="btnHistorial" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarHistorial" styleClass="button-lateral" text="• Historial" />
                <Button fx:id="btnReportes" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarReportes" styleClass="button-lateral" text="• Generar reporte" />
                <Button fx:id="btnUmbrales" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarUmbrales" styleClass="button-lateral" text="• Umbrales de variables" />
                <Button fx:id="btnAlarmas" maxWidth="Infinity" mnemonicParsing="false" onAction="#mostrarAlarmas" styleClass="button-lateral" text="• Sistema de alarmas" />
            </children>
            <padding>
                <Insets bottom="20.0" left="5.0" right="5.0" top="20.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
