<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #EDF4FB;" stylesheets="@../../styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.laventurosa.adapters.ui.panels.GenerarReportePanel">
    <children>
        <VBox spacing="20.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <Label text="Generar Reporte de Calidad de Agua" textFill="#2447A4">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <VBox spacing="15.0" styleClass="panel-choince-vq" style="-fx-padding: 30;">
                    <children>
                        <Label styleClass="text-label-general" text="Seleccione el rango de fechas:">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <HBox spacing="20.0">
                            <children>
                                <DatePicker fx:id="dateInicio" promptText="Fecha Inicio" />
                                <DatePicker fx:id="dateFin" promptText="Fecha Fin" />
                            </children>
                        </HBox>

                        <Button fx:id="generar_reporte" mnemonicParsing="false" onAction="#generarReporte" prefHeight="41.0" prefWidth="200.0" styleClass="btn-guardar" text="Exportar a PDF" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>