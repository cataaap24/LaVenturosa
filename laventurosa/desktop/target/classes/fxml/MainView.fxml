<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.laventurosa.adapters.ui.MainView">
    <left>
        <VBox prefHeight="400.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnEstado" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarEstado" text="Estado de la laguna" />
                <Button fx:id="btnHistorial" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarHistorial" text="Historial" />
                <Button fx:id="btnReportes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarReportes" text="Generar reporte" />
                <Button fx:id="btnUmbrales" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarUmbrales" text="Umbrales de variables" />
                <Button fx:id="btnAlarmas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#mostrarAlarmas" text="Sistema de alarmas" />
            </children>
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>